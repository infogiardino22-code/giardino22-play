---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Riga from '../../components/Riga.astro';
import Icona from '../../components/Icona.astro';
import { produzioni, episodiDi, videoDi, linkVideo, media, url, ETICHETTE , classeLogo } from '../../lib/catalogo.js';

export function getStaticPaths() {
  return produzioni.map(p => ({ params: { produzione: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const episodi = episodiDi(p.slug);
const short = videoDi(p.slug).filter(v => v.short);
const social = Object.entries(p.social);
const primo = episodi[0];
const jsonld = {
  '@context': 'https://schema.org', '@type': 'CreativeWorkSeries', name: p.nome, description: p.descrizione,
  url: new URL(url(p.slug + '/'), Astro.site).href, image: new URL(media(p.img.hero), Astro.site).href,
};
---
<Base titolo={p.nome} descrizione={p.descrizione} immagine={media(p.img.heroPiccola)} jsonld={jsonld}>
  <section class="shero">
    <img src={media(p.img.hero)} srcset={`${media(p.img.heroPiccola)} 960w, ${media(p.img.hero)} 1920w`} sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" />
    <div class="wrap">
      {p.img.logo && <img class={`slide__logo ${classeLogo(p)}`} src={media(p.img.logo)} alt="" />}
      <div class="eyebrow">{p.categoria} · {p.conteggio.episodi} episodi{p.conteggio.short ? ` · ${p.conteggio.short} clip` : ''}</div>
      <h1 class={p.img.logo ? 'sr' : ''}>{p.nome}</h1>
      <p>{p.descrizione}</p>
      {primo && <div class="btns"><a class="btn btn--main" href={linkVideo(primo)}><Icona nome="play" /> Inizia dall'episodio {primo.episodio ?? 1}</a></div>}
      {social.length > 0 && (
        <div class="socials">
          {social.map(([k, u]) => <a href={u} target="_blank" rel="noopener" aria-label={`${p.nome} su ${ETICHETTE[k]}`} title={ETICHETTE[k]}><Icona nome={k} /></a>)}
        </div>
      )}
    </div>
  </section>

  <div class="stack">
    {episodi.length > 0 && (
      <section class="wrap reveal eps" aria-labelledby="h-episodi" data-eps>
        <div class="row__head">
          <div><div class="eyebrow">Tutte le puntate</div><h2 id="h-episodi">Episodi</h2></div>
          <span class="eps__pag" aria-live="polite"></span>
        </div>
        <div class="eps__grid">{episodi.map(v => <Card v={v} forma="h" mostraFormat={false} />)}</div>
        <div class="prog" aria-hidden="true"><span></span></div>
      </section>
    )}
    <Riga id="clip" sopratitolo="Contenuti brevi" titolo="Clip e Short" video={short} forma="v" mostraFormat={false} />
  </div>
</Base>

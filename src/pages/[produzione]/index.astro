---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Riga from '../../components/Riga.astro';
import Icona from '../../components/Icona.astro';
import { produzioni, episodiDi, videoDi, linkVideo, media, url, primaRiga, ETICHETTE , classeLogo } from '../../lib/catalogo.js';
import { organizzazione, briciole, SITO } from '../../lib/seo.js';

export function getStaticPaths() {
  return produzioni.map(p => ({ params: { produzione: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const episodi = episodiDi(p.slug);
const short = videoDi(p.slug).filter(v => v.short);
const social = Object.entries(p.social);
const primo = episodi[0];
const urlFormat = new URL(url(p.slug + '/'), Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CreativeWorkSeries', '@id': urlFormat + '#serie', name: p.nome, description: p.descrizione,
      url: urlFormat, image: new URL(media(p.img.hero), Astro.site).href, inLanguage: 'it-IT',
      genre: p.categoria || undefined,
      publisher: { '@id': `${SITO}/#organizzazione` }, creator: { '@id': `${SITO}/#organizzazione` },
      sameAs: Object.values(p.social || {}).filter(Boolean),
      hasPart: videoDi(p.slug).slice(0, 40).map(v => ({
        '@type': 'VideoObject', name: v.titoloOriginale, url: new URL(linkVideo(v), Astro.site).href,
        thumbnailUrl: new URL(media(v.img.h), Astro.site).href, uploadDate: v.pubblicato, duration: `PT${v.secondi}S`,
        description: primaRiga(v.descrizione, 200) || v.titolo,
      })),
    },
    briciole([['Giardino22 Play', '/'], [p.nome, '/' + p.slug + '/']], Astro.site),
    organizzazione(Astro.site),
  ],
};
---
<Base titolo={p.nome} descrizione={p.descrizione} immagine={media(p.img.heroPiccola)} jsonld={jsonld}>
  <section class={`shero f-${p.slug}`}>
    <img src={media(p.img.hero)} srcset={`${media(p.img.heroPiccola)} 960w, ${media(p.img.hero)} 1920w`} sizes="100vw" alt="" width="1920" height="1080" fetchpriority="high" />
    <div class="wrap">
      {p.img.logo && <img class={`slide__logo ${classeLogo(p)}`} src={media(p.img.logo)} alt="" />}
      <div class="eyebrow">{p.categoria} · {p.conteggio.episodi} episodi{p.conteggio.short ? ` · ${p.conteggio.short} clip` : ''}</div>
      <h1 class={p.img.logo ? 'sr' : ''}>{p.nome}</h1>
      <p>{p.descrizione}</p>
      {primo && <div class="btns"><a class="btn btn--main" href={linkVideo(primo)}><Icona nome="play" /> Inizia dall'episodio {primo.episodio ?? 1}</a></div>}
      {social.length > 0 && (
        <div class="socials">
          {social.map(([k, u]) => <a href={u} target="_blank" rel="noopener" aria-label={`${p.nome} su ${ETICHETTE[k]}`} title={ETICHETTE[k]}><Icona nome={k} /></a>)}
        </div>
      )}
    </div>
  </section>

  <div class={`stack f-${p.slug}`}>
    {episodi.length > 0 && (
      <section class="wrap reveal eps row--format" aria-labelledby="h-episodi" data-eps>
        <div class="row__head">
          <div><div class="eyebrow">Tutte le puntate</div><h2 id="h-episodi">Episodi</h2></div>
          <span class="eps__pag" aria-live="polite"></span>
        </div>
        <div class="eps__grid">{episodi.map(v => <Card v={v} forma="h" mostraFormat={false} />)}</div>
        <div class="prog" aria-hidden="true"><span></span></div>
      </section>
    )}
    <Riga id="clip" sopratitolo="Contenuti brevi" titolo="Clip e Short" video={short} forma="v" mostraFormat={false} colore={p.slug} />
  </div>
</Base>

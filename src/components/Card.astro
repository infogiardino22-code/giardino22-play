---
// Card video: miniatura pulita (solo etichette), testi sotto l'immagine.
// Così il titolo non si sovrappone alle scritte già presenti nelle miniature.
import Icona from './Icona.astro';
import { perSlug, linkVideo, media, eNuovo, primaRiga } from '../lib/catalogo.js';
const { v, forma = 'v', mostraFormat = true } = Astro.props;
const p = perSlug.get(v.produzione);
const MESI = ['gen', 'feb', 'mar', 'apr', 'mag', 'giu', 'lug', 'ago', 'set', 'ott', 'nov', 'dic'];
const d = new Date(v.pubblicato);
const info = [v.episodio ? 'Ep. ' + String(v.episodio).padStart(2, '0') : (v.short ? 'Short' : null), `${d.getUTCDate()} ${MESI[d.getUTCMonth()]}`].filter(Boolean);
const w = forma === 'v' ? 540 : 960, h = forma === 'v' ? 960 : 540;
const nuovo = eNuovo(v);
---
<a class={`card card--${forma} f-${v.produzione} t-${v.id}`} href={linkVideo(v)} aria-label={`${v.titolo} · ${p?.nome} · ${v.durata}`}>
  <div class="thumb">
    <img class="main" src={media(forma === 'v' ? v.img.v : v.img.h)} alt="" width={w} height={h} loading="lazy" decoding="async" />
    {(p?.original || nuovo) && (
      <div class="tags">
        {nuovo && <span class="tag tag--new">Nuovo</span>}
        {p?.original && <span class="tag">G22 Original</span>}
      </div>
    )}
    <span class="dur">{v.durata}</span>
    <span class="play" aria-hidden="true"><Icona nome="play" /></span>
  </div>
  <div class="cap">
    {mostraFormat && <span class="cap__f">{p?.nome}</span>}
    <h3>{v.titolo}</h3>
    <div class="meta">{info.map((x, i) => <>{i > 0 && <i></i>}<span>{x}</span></>)}</div>
    {forma === 'h' && <p>{primaRiga(v.descrizione, 140)}</p>}
  </div>
</a>

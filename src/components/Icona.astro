---
// Set di icone a tratto, tutte disegnate sulla stessa griglia 24×24.
const { nome } = Astro.props;
---
<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {nome === 'play' && <path d="M6 4l14 8-14 8z" fill="currentColor" stroke="none" />}
  {nome === 'sx' && <path d="M15 5l-7 7 7 7" stroke-width="2.4" />}
  {nome === 'dx' && <path d="M9 5l7 7-7 7" stroke-width="2.4" />}
  {nome === 'lista' && <path d="M4 6h16M4 12h16M4 18h10" stroke-width="2.4" />}
  {nome === 'menu' && <path d="M3 7h18M3 12h18M3 17h18" stroke-width="2" />}
  {nome === 'link' && <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />}
  {nome === 'youtube' && <><rect x="2" y="5" width="20" height="14" rx="4" /><path d="M10 9l5 3-5 3z" fill="currentColor" /></>}
  {nome === 'spotify' && <><circle cx="12" cy="12" r="10" /><path d="M7 9.6c3.5-1 7.3-.7 10.2.9M7.6 12.7c2.9-.8 6-.5 8.4.8M8.2 15.6c2.3-.6 4.6-.4 6.6.6" /></>}
  {nome === 'amazon_music' && <><path d="M9 18V6l10-2v12" /><circle cx="6.5" cy="18" r="2.5" /><circle cx="16.5" cy="16" r="2.5" /></>}
  {nome === 'apple_podcasts' && <><circle cx="12" cy="10.5" r="2.5" /><path d="M12 14v7M7 16.2a7 7 0 1 1 10 0" /></>}
  {nome === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".9" fill="currentColor" /></>}
  {nome === 'tiktok' && <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.2 5 4.4" />}
  {nome === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M7.5 10.5v6M7.5 7.5v.1M11 16.5v-6M11 13.2c0-1.8 1-2.8 2.5-2.8s2.5 1 2.5 2.8v3.3" /></>}
  {nome === 'facebook' && <path d="M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v7H14v-7h2.5l.5-3.5h-3z" />}
  {nome === 'sito' && <><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9s1.3-6.4 3.8-9z" /></>}
</svg>
